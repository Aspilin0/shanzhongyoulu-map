        },
        {
          "text": "历史时间",
          "size": 12,
          "selector": "B."
        },
        {
          "text": "1937 年 12 月 — 1946 年",
          "size": 12,
          "selector": "SPAN."
        },
        {
          "text": "历史地点",
          "size": 12,
          "selector": "B."
        },
        {
          "text": "浙江龙泉 → 贵阳 · 地母洞",
          "size": 12,
          "selector": "SPAN."
        },
        {
          "text": "园区景观",
          "size": 12,
          "selector": "B."
        },
        {
          "text": "北山游步道东北段 ·《保护四库全书》雕塑（南麓另有西迁办学纪念碑亭）",
          "size": 12,
          "selector": "SPAN."
        },
        {
          "text": "现代实拍",
          "size": 12,
          "selector": "SPAN.figure__badge figure__badge--now"
        },
        {
          "text": "北山游步道东北段的《保护四库全书》雕塑现状。",
          "size": 12,
          "selector": "SPAN."
        },
        {
          "text": "历史示意图",
          "size": 12,
          "selector": "SPAN.figure__badge figure__badge--then"
        },
        {
          "text": "搬运书箱的场景。",
          "size": 12,
          "selector": "SPAN."
        },
        {
          "text": "文澜阁《四库全书》原藏杭州，共一百三十九箱。战事迫近后，竺可桢派校车、教师协助浙江图书馆转移藏书，经龙泉等地转运到贵阳附近的地母洞。",
          "size": 14,
          "selector": "P."
        },
        {
          "text": "山洞潮湿，保管人员要定期搬出书册晾晒。浙大迁往遵义、湄潭后，竺可桢仍多次到洞中检查保管情况。这批书于战后运回杭州。",
          "size": 14,
          "selector": "P."
        },
        {
          "text": "资料来源",
          "size": 14,
          "selector": "SUMMARY."
        },
        {
          "text": "S3",
          "size": 12,
          "selector": "SPAN.src-row__id"
        },
        {
          "text": "《浙大西迁办学纪念碑亭落成》",
          "size": 14,
          "selector": "SPAN.src-row__title"
        },
        {
          "text": "浙江大学求是新闻网 · 2013-05-21",
          "size": 12,
          "selector": "SPAN.src-row__meta"
        },
        {
          "text": "S4",
          "size": 12,
          "selector": "SPAN.src-row__id"
        },
        {
          "text": "《浙江大学西迁办学纪念碑奠基》",
          "size": 14,
